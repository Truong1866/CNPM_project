<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ResidentFormController">

   <Label layoutX="20.0" layoutY="20.0" text="Thông tin cư dân">
      <font><Font name="Inter Bold" size="22.0" /></font>
   </Label>

   <!-- CCCD -->
   <Label layoutX="20.0"  layoutY="75.0" text="CCCD / Mã cư dân *">
      <font><Font name="Inter Regular" size="15.0" /></font>
   </Label>
   <TextField fx:id="idField" layoutX="220.0" layoutY="70.0"
              prefWidth="280.0" promptText="Bắt buộc" />

   <!-- Họ tên -->
   <Label layoutX="20.0" layoutY="125.0" text="Họ và tên *">
      <font><Font name="Inter Regular" size="15.0" /></font>
   </Label>
   <TextField fx:id="nameField" layoutX="220.0" layoutY="120.0"
              prefWidth="280.0" promptText="Bắt buộc" />

   <!-- Ngày sinh -->
   <Label layoutX="20.0" layoutY="175.0" text="Ngày sinh">
      <font><Font name="Inter Regular" size="15.0" /></font>
   </Label>
   <DatePicker fx:id="birthdayPicker" layoutX="220.0" layoutY="170.0"
               prefWidth="280.0" promptText="dd/MM/yyyy" />

   <!-- Số điện thoại -->
   <Label layoutX="20.0" layoutY="225.0" text="Số điện thoại">
      <font><Font name="Inter Regular" size="15.0" /></font>
   </Label>
   <TextField fx:id="teleField" layoutX="220.0" layoutY="220.0"
              prefWidth="280.0" promptText="Tùy chọn" />

   <!-- Thông báo lỗi -->
   <Label fx:id="errorLabel" layoutX="20.0" layoutY="270.0"
          style="-fx-text-fill: #e53935;" text="" wrapText="true" prefWidth="480.0">
      <font><Font name="Inter Regular" size="13.0" /></font>
   </Label>

   <!-- Buttons -->
   <HBox layoutX="20.0" layoutY="360.0" spacing="15.0">
      <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave"
              prefWidth="120.0" prefHeight="38.0" text="Lưu"
              style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14;" />
      <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel"
              prefWidth="120.0" prefHeight="38.0" text="Hủy"
              style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14;" />
   </HBox>
</AnchorPane>
